{
  "name": "silly-park",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "play": "vite build && vite preview --port 4321 --host 0.0.0.0 --open",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run lint && npm test && npm run build",
    "ci": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@react-three/fiber": "^9.5.0",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "scheduler": "^0.27.0",
    "three": "^0.183.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.2"
  }
}
